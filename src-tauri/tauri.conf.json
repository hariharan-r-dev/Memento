{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Lucky Charm",
  "version": "0.1.0",
  "identifier": "com.luckycharm.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lucky Charm",
        "width": 1920,
        "height": 1080,
        "x": 0,
        "y": 0,
        "center": false,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg"],
    "resources": ["dlls/*"],
    "shortDescription": "A little bit of luck, hanging from your screen.",
    "longDescription": "A tactile lucky talisman desktop companion that hangs from the top bezel of your display with real-time rope and pendulum physics.",
    "copyright": "Copyright © 2026 Lucky Charm",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer_hooks.nsh"
      }
    }
  }
}
